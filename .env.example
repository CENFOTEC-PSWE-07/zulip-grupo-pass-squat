# Copy this file to .env and replace the placeholder values.

# Core Zulip service secrets
ZULIP__POSTGRES_PASSWORD=replace_with_random_hex
ZULIP__MEMCACHED_PASSWORD=replace_with_random_hex
ZULIP__RABBITMQ_PASSWORD=replace_with_random_hex
ZULIP__REDIS_PASSWORD=replace_with_random_hex
ZULIP__SECRET_KEY=replace_with_random_hex
ZULIP__EMAIL_PASSWORD=unused_local

# Incoming email gateway settings
# Keep this short so generated addresses stay under email local-part limits.
EMAIL_GATEWAY_PATTERN=z+%s@gmail.com
EMAIL_GATEWAY_IMAP_SERVER=imap.gmail.com
EMAIL_GATEWAY_IMAP_PORT=993
EMAIL_GATEWAY_IMAP_USERNAME=your_email@gmail.com
EMAIL_GATEWAY_IMAP_PASSWORD=replace_with_app_password
EMAIL_GATEWAY_IMAP_FOLDER=INBOX
